{
  "manifest_version": 3,
  "name": "SK@S — Pemindahan Skor MOEIS",
  "version": "0.3.0",
  "minimum_chrome_version": "102",
  "description": "Ambil skor Standard 4 dan snapshot skor wajaran Kekuatan Kami A1–A9 ke pratonton SK@S.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pemindahan SK@S"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://moeisins.moe.gov.my"
  },
  "host_permissions": [
    "https://skas-sekolah.github.io/skpmkualitisekolah/*"
  ]
}
