{
  "manifest_version": 3,
  "name": "SK@S — Pemindahan Skor MOEIS",
  "version": "0.5.0",
  "minimum_chrome_version": "102",
  "description": "Pemindahan dua hala SK@S/MOEIS: kutip skor dan isi borang daripada pakej empat modul atau CSV Standard 4.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pemindahan SK@S"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://moeisins.moe.gov.my"
  },
  "host_permissions": [
    "https://skas-sekolah.github.io/skpmkualitisekolah/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
